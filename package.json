{
  "name": "pi-dsh-tools",
  "version": "0.2.0",
  "description": "DeepSeek Harness (DSH) agent controls reimplemented for Pi: goals, todos, jobs, terminals, subagents, workflows, PTC, guards, spill, and filesystem policy.",
  "type": "module",
  "license": "MIT",
  "author": "Dan Campos",
  "homepage": "https://github.com/zbrdc/pi-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbrdc/pi-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/zbrdc/pi-dsh/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "coding-agent",
    "subagents",
    "workflow"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "pi-dsh.example.json",
    "dsh-compat.json",
    "scripts/check-dsh-drift.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/core.test.ts tests/extension.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "check:drift": "node scripts/check-dsh-drift.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24",
    "typebox": "*",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
